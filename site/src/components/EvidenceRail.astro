---
interface EvidenceItem {
  id: string;
  date: string;
  title: string;
  source: string;
  url: string;
  note?: string;
}
interface Props { thesis?: string; items: EvidenceItem[]; label?: string; }
const { thesis, items, label = "Evidence chain" } = Astro.props;
---

<section class="evidence-rail" aria-label={label}>
  {thesis && <p class="rail-thesis">{thesis}</p>}
  <ol>
    {items.map((item) => (
      <li>
        <span class="rail-node" aria-hidden="true"></span>
        <div class="rail-meta">
          <time datetime={item.date}>{item.date}</time>
          <span>{item.source}</span>
          <code>{item.id}</code>
        </div>
        <a href={item.url}>{item.title}</a>
        {item.note && <p>{item.note}</p>}
      </li>
    ))}
  </ol>
</section>

<style>
  .evidence-rail { --rail: var(--trace-violet); }
  .rail-thesis {
    max-width: 62ch;
    margin: 0 0 var(--space-5);
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2vw, 1.65rem);
    font-weight: 620;
    line-height: 1.2;
  }
  ol { list-style: none; margin: 0; padding: 0 0 0 27px; position: relative; }
  ol::before { content: ""; position: absolute; left: 5px; top: 9px; bottom: 10px; width: 2px; background: var(--rail); opacity: 0.7; }
  li { position: relative; padding: 0 0 var(--space-5) var(--space-4); }
  li:last-child { padding-bottom: 0; }
  .rail-node { position: absolute; left: -27px; top: 5px; width: 12px; height: 12px; border: 3px solid var(--bg-elev); background: var(--rail); box-shadow: 0 0 0 1px var(--rail); }
  .rail-meta { display: flex; flex-wrap: wrap; gap: var(--space-2); color: var(--ink-muted); font: 600 0.64rem/1.4 var(--font-mono); text-transform: uppercase; letter-spacing: 0.035em; }
  .rail-meta code { color: var(--trace-violet); }
  li > a { display: inline-block; margin-top: 3px; font-weight: 650; text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--trace-violet) 45%, transparent); text-underline-offset: 3px; }
  li p { color: var(--ink-muted); font-size: 0.8rem; margin: var(--space-1) 0 0; }
</style>
