---
import { TRACK_LABELS, type Track } from "../lib/taxonomy";
interface Props { track: Track; linked?: boolean; }
const { track, linked = false } = Astro.props;
const label = TRACK_LABELS[track];
---

{linked ? (
  <a class="track-tag" href={`/developments?track=${track}`} data-track={track}>{label}</a>
) : (
  <span class="track-tag" data-track={track}>{label}</span>
)}

<style>
  .track-tag {
    display: inline-flex;
    align-items: center;
    min-height: 25px;
    padding: 3px 8px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: rgba(16, 11, 32, .42);
    color: var(--muted);
    font: 500 0.61rem/1.2 var(--font-mono);
    letter-spacing: 0.015em;
  }
  a.track-tag:hover { color: var(--cyan); border-color: var(--cyan); }
</style>
