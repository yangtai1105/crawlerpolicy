---
import { TRACK_LABELS, type Track } from "../lib/taxonomy";
interface Props { track: Track; linked?: boolean; }
const { track, linked = false } = Astro.props;
const label = TRACK_LABELS[track];
---

{linked ? (
  <a class="track-tag" href={`/developments?track=${track}`} data-track={track}>{label}</a>
) : (
  <span class="track-tag" data-track={track}>{label}</span>
)}

<style>
  .track-tag {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: 3px 10px;
    border: 1px solid var(--rule);
    border-radius: 9px;
    background: var(--paper-high);
    color: var(--ink-muted);
    font: 400 0.74rem/1.2 var(--font-body);
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  a.track-tag:hover { color: var(--accent); border-color: var(--accent-soft); }
</style>
