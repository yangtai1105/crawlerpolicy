---
import { FRONT_LABELS, FRONT_TRACKS, type Front } from "../lib/taxonomy";
import TrackTag from "./TrackTag.astro";
interface Props { front: Front; summary: string; status?: "active" | "watch" | "quiet"; }
const { front, summary, status = "quiet" } = Astro.props;
---

<article class="front-card" data-status={status}>
  <div class="front-topline">
    <span class="utility-label">Theme</span>
    <span class="front-status">{status}</span>
  </div>
  <h3><a href={`/fronts/${front}`}>{FRONT_LABELS[front]}</a></h3>
  <p>{summary}</p>
  <div class="front-tracks">
    {FRONT_TRACKS[front].map((track) => <TrackTag track={track} />)}
  </div>
  <a class="front-link" href={`/fronts/${front}`} aria-label={`Open ${FRONT_LABELS[front]} intelligence`}>Follow theme <span aria-hidden="true">→</span></a>
</article>

<style>
  .front-card { min-height: 280px; display: flex; flex-direction: column; padding: var(--space-5); border: 1px solid var(--quiet-rule); border-top: 4px solid var(--quiet-rule); border-radius: var(--radius-sm); background: var(--paper-high); }
  .front-card[data-status="active"] { border-top-color: var(--clay-marker); }
  .front-card[data-status="watch"] { border-top-color: var(--trace-violet); }
  .front-topline { display: flex; justify-content: space-between; gap: var(--space-3); }
  .front-status { font: 600 0.61rem/1.3 var(--font-mono); text-transform: uppercase; color: var(--ink-muted); }
  h3 { font-size: clamp(1.45rem, 2.2vw, 2rem); margin: var(--space-5) 0 var(--space-3); }
  p { color: var(--ink-muted); font-size: 0.88rem; line-height: 1.68; }
  .front-tracks { display: flex; gap: var(--space-2); flex-wrap: wrap; margin-top: auto; padding-top: var(--space-4); }
  .front-link { margin-top: var(--space-5); padding-top: var(--space-3); border-top: 1px solid var(--border); color: var(--forest-block); font: 600 0.67rem/1.2 var(--font-mono); }
  .front-link span { float: right; }
</style>
