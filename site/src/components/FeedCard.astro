---
import TrackTag from "./TrackTag.astro";
import type { Track } from "../lib/taxonomy";

interface Props {
  slug: string;
  title: string;
  source: string;
  publishedAt: Date;
  status: "verified" | "reported" | "signal";
  summary: string;
  analyticalLabel: "Insight" | "Implication" | "Why it matters";
  analyticalText: string;
  tracks: Track[];
}

const {
  slug,
  title,
  source,
  publishedAt,
  status,
  summary,
  analyticalLabel,
  analyticalText,
  tracks,
} = Astro.props;
---

<article class="feed-card" data-status={status}>
  <div class="feed-card-meta">
    <span class="feed-status">{status}</span>
    <span>{source}</span>
    <time datetime={publishedAt.toISOString()}>{publishedAt.toISOString().slice(0, 10)}</time>
  </div>
  <h3><a href={`/events/${slug}`}>{title}</a></h3>
  <p class="feed-summary">{summary}</p>
  <div class="feed-analysis">
    <span>{analyticalLabel}</span>
    <p>{analyticalText}</p>
  </div>
  <div class="feed-footer">
    <div>{tracks.map((track) => <TrackTag track={track} linked />)}</div>
    <a href={`/events/${slug}`}>Read analysis <span aria-hidden="true">→</span></a>
  </div>
</article>

<style>
  .feed-card { padding: var(--space-5) 0; border-top: 1px solid var(--border-strong); }
  .feed-card-meta { display: flex; flex-wrap: wrap; gap: var(--space-3); color: var(--ink-muted); font: 600 .65rem var(--font-mono); text-transform: uppercase; }
  .feed-status { color: var(--protocol-blue); }
  h3 { margin: var(--space-3) 0; font-size: clamp(1.3rem, 2.3vw, 1.9rem); }
  .feed-summary { max-width: 72ch; color: var(--ink-muted); }
  .feed-analysis { max-width: 72ch; padding-left: var(--space-3); border-left: 2px solid var(--pillar-ecosystem); }
  .feed-analysis > span { color: var(--pillar-ecosystem); font: 650 .63rem var(--font-mono); text-transform: uppercase; }
  .feed-analysis p { margin: var(--space-1) 0 0; font-size: .86rem; }
  .feed-footer { display: flex; justify-content: space-between; gap: var(--space-4); align-items: end; margin-top: var(--space-4); }
  .feed-footer > div { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .feed-footer > a { font: 650 .7rem var(--font-mono); white-space: nowrap; }
</style>
