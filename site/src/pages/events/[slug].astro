---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import TrackTag from "../../components/TrackTag.astro";
import TimeAgo from "../../components/TimeAgo.astro";
import { findSource } from "../../lib/sources";
import { loadCurrentEvents } from "../../lib/events";
import { loadFeedItems } from "../../lib/feed";

export async function getStaticPaths() {
  const feed = await loadFeedItems();
  const current = await loadCurrentEvents();
  const legacy = await getCollection("legacyEvents");
  const feedSlugs = new Set(feed.map((item) => item.data.slug));
  const currentSlugs = new Set(current.map((event) => event.data.slug));
  return [
    ...feed.map((event) => ({
      params: { slug: event.data.slug },
      props: { event, kind: "feed" },
    })),
    ...current.map((event) => ({
      params: { slug: event.data.slug },
      props: { event, kind: "event" },
    })).filter((entry) => !feedSlugs.has(entry.params.slug)),
    ...legacy
      .filter((event) => !currentSlugs.has(event.data.slug) && !feedSlugs.has(event.data.slug))
      .map((event) => ({
        params: { slug: event.data.slug },
        props: { event, kind: "legacy" },
      })),
  ];
}

const { event, kind } = Astro.props;
const isLegacy = kind === "legacy";
const isFeed = kind === "feed";
const { Content } = await render(event);
const source = findSource(event.data.source);
const legacyData = isLegacy ? event.data as CollectionEntry<"legacyEvents">["data"] : null;
const currentData = kind === "event" ? event.data as CollectionEntry<"events">["data"] : null;
const feedData = isFeed ? event.data as CollectionEntry<"feed">["data"] : null;
const displayDate = legacyData?.detected_at ?? currentData?.event_date ?? feedData!.event_date;
const legacyOrCurrentUrl = legacyData?.source_url ?? currentData?.source_url ?? "";
const sourceUrls = feedData?.source_urls ?? (legacyOrCurrentUrl ? [legacyOrCurrentUrl] : []);
const publicationLabel = feedData ? feedData.status[0].toUpperCase() + feedData.status.slice(1) : "";
const originalPublicationDate = feedData?.published_at.toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
---

<Base title={event.data.title} description={`Tracked change from ${source?.display_name ?? event.data.source}`}>
  <article class="container event-page">
    <header class="event-page-header">
      <div class="event-page-meta">
        {isLegacy ? (
          <span class="legacy-label">Legacy record · {legacyData!.pillar}</span>
        ) : isFeed ? (
          <>
            <span class={`publication-status status-${feedData!.status}`}>{publicationLabel}</span>
            {feedData!.backfilled && <span class="backfill-note">Backfilled · Original publication {originalPublicationDate}</span>}
            <span class="current-tracks">{feedData!.tracks.map((track) => <TrackTag track={track} linked />)}</span>
          </>
        ) : (
          <span class="current-tracks">{currentData!.tracks.map((track) => <TrackTag track={track} linked />)}</span>
        )}
        <span class="source-name">
          {source?.display_name ?? event.data.source}
        </span>
        <span class="dot">·</span>
        <TimeAgo date={displayDate} />
      </div>
      <h1 class="event-page-title">{event.data.title}</h1>
      {sourceUrls.length > 0 && (
        <p class="event-page-url">
          {sourceUrls.map((url) => <a href={url} target="_blank" rel="noopener noreferrer">Open source ↗</a>)}
        </p>
      )}
    </header>

    <div class="event-page-body">
      <Content />
    </div>

    <footer class="event-page-footer">
      {isLegacy ? (
        <p>
          This schema-v1 item is preserved unchanged for historical reference and is excluded
          from current intelligence, trend status, and weekly calculations. <a href="/archive">Open Legacy Archive →</a>
        </p>
      ) : isFeed ? (
        <p>
          {feedData!.status === "verified" ? "Verified against primary or measurement evidence." : feedData!.status === "reported" ? "Reported from a configured specialist source; it does not independently move a trend." : "Early signal; not yet verified by primary evidence."}
        </p>
      ) : (
        <p>
          Model-generated synthesis is labeled analysis. Linked evidence and raw diffs remain
          the authoritative record.
        </p>
      )}
      <p>
        <a href={`/sources/${event.data.source}`}>
          See all tracked changes from {source?.display_name ?? event.data.source} →
        </a>
      </p>
    </footer>
  </article>
</Base>

<style>
  .event-page {
    max-width: 920px;
    padding: var(--space-8) var(--space-5);
  }
  .event-page-header {
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--border);
    margin-bottom: var(--space-6);
  }
  .event-page-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    font-size: 0.85rem;
    color: var(--ink-muted);
    margin-bottom: var(--space-3);
  }
  .source-name { color: var(--ink); }
  .dot { opacity: 0.5; }
  .event-page-title {
    max-width: 18ch;
    font-size: clamp(2.3rem, 5vw, 4.8rem);
    line-height: 1.05;
  }
  .event-page-url {
    margin-top: var(--space-3);
    font-size: 0.85rem;
    color: var(--ink-muted);
    word-break: break-all;
  }
  .event-page-url a { color: var(--pillar-ecosystem); }
  .legacy-label {
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    padding: 0.15rem 0.5rem;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }
  .publication-status { border-top: 3px solid currentColor; padding: .2rem 0; font: 600 .63rem var(--font-mono); text-transform: uppercase; }
  .status-verified { color: var(--status-healthy); }
  .status-reported { color: var(--pillar-ecosystem); }
  .status-signal { color: var(--status-degraded); }
  .backfill-note { color: var(--clay-marker); font: 600 .66rem/1.4 var(--font-mono); text-transform: uppercase; }
  .current-tracks { display: inline-flex; flex-wrap: wrap; gap: var(--space-2); }

  .event-page-body :global(h2) {
    font-size: 1.35rem;
    margin-top: var(--space-7);
    margin-bottom: var(--space-3);
  }
  .event-page-body :global(h2):first-of-type { margin-top: 0; }
  .event-page-body :global(p) { max-width: 72ch; color: var(--ledger-ink); font-size: 1rem; line-height: 1.75; }
  .event-page-body :global(h2:nth-of-type(4)) { color: var(--clay-marker); }
  .event-page-body :global(h2:nth-of-type(5)) { margin-top: var(--space-8); padding: var(--space-6) var(--space-6) var(--space-3); background: var(--forest-block); color: var(--paper-high); }
  .event-page-body :global(h2:nth-of-type(5) ~ *) { margin-top: 0; margin-bottom: 0; padding: 0 var(--space-6) var(--space-4); background: var(--forest-block); color: #dce8e0; }
  .event-page-body :global(h2:nth-of-type(5) ~ *:last-child) { padding-bottom: var(--space-6); }
  .event-page-body :global(h2:nth-of-type(5) ~ * a) { color: #b6dcc7; text-decoration: underline; }

  .event-page-body :global(details) {
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: var(--space-3) var(--space-4);
    margin-top: var(--space-5);
    background: var(--paper-high);
  }
  .event-page-body :global(summary) {
    cursor: pointer;
    color: var(--ink-muted);
    font-size: 0.88rem;
    font-weight: 500;
  }
  .event-page-body :global(details[open]) { padding-bottom: var(--space-4); }
  .event-page-body :global(pre.astro-code),
  .event-page-body :global(pre) {
    font-size: 0.8rem;
    max-height: 500px;
  }

  .event-page-footer {
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
    color: var(--ink-muted);
    font-size: 0.82rem;
  }
  .event-page-footer a { color: var(--pillar-ecosystem); }
</style>
