---
import Base from "../../layouts/Base.astro";
import TrackTag from "../../components/TrackTag.astro";
import DevelopmentCard from "../../components/DevelopmentCard.astro";
import { loadHealth } from "../../lib/health";
import { loadSources } from "../../lib/sources";
import { listSnapshots } from "../../lib/snapshots";
import { loadCurrentEvents } from "../../lib/events";

export function getStaticPaths() { return loadSources().map((source) => ({ params: { slug: source.slug }, props: { source } })); }
const { source } = Astro.props;
const health = loadHealth();
const stage = health.per_source[source.slug];
const events = (await loadCurrentEvents()).filter((event) => event.data.source === source.slug).sort((a, b) => b.data.event_date.getTime() - a.data.event_date.getTime());
const snapshots = listSnapshots(source.slug);
const sourceUrl = source.url ?? (source.repo ? `https://github.com/${source.repo}` : source.draft_name ? `https://datatracker.ietf.org/doc/${source.draft_name}/` : null);
function bodySummary(body: string | undefined) { return body?.match(/## Why it matters\s*\n+([^#]+)/)?.[1].trim().slice(0, 260) ?? ""; }
---

<Base title={source.display_name}>
  <main class="container source-page">
    <header class="source-header observation-grid">
      <div class="source-index"><p class="utility-label">{source.role}</p><p>{source.tier} tier<br />{source.type}</p>{source.required_for_coverage && <strong>Required coverage</strong>}</div>
      <div><h1>{source.display_name}</h1><div class="tracks">{source.default_tracks.map((track) => <TrackTag track={track} linked />)}</div>{sourceUrl && <a class="official-link" href={sourceUrl}>Open official source ↗</a>}</div>
    </header>

    <section class="stage-health" aria-label="Source pipeline stages">
      {(["fetch", "evidence", "analysis", "publish"] as const).map((name) => <div><span class="utility-label">{name}</span><strong>{stage?.[name] ?? "pending"}</strong></div>)}
      <p>{stage?.error ?? "No schema-v2 stage result is available for this source yet."}</p>
    </section>

    <section>
      <div class="section-heading"><p class="utility-label">Current material record</p><h2>Developments</h2></div>
      {events.length ? events.map((event) => <DevelopmentCard slug={event.data.slug} title={event.data.title} source={source.display_name} eventDate={event.data.event_date} tracks={[...event.data.tracks]} tier={event.data.source_tier} confidence={event.data.confidence} summary={bodySummary(event.body)} />) : <p class="empty">No post-refactor material development has been published from this source.</p>}
    </section>

    <section>
      <div class="section-heading"><p class="utility-label">Collected artifacts</p><h2>Snapshot ledger</h2></div>
      <p class="ledger-copy">{snapshots.length} stored snapshot{snapshots.length === 1 ? "" : "s"}. Snapshots support evidence creation but do not become current intelligence by themselves.</p>
      {snapshots.length > 0 && <ul class="snapshot-list">{snapshots.slice(0, 24).map((snapshot) => <li><code>{snapshot.filename}</code><time>{snapshot.date}</time></li>)}</ul>}
      <a class="archive-link" href="/archive">Legacy events from this source remain in the historical archive →</a>
    </section>
  </main>
</Base>

<style>
  .source-page { padding-top: var(--space-8); }
  .source-header { padding-bottom: var(--space-8); }
  .source-index { grid-column: 1 / 4; color: var(--ink-muted); font: 0.72rem/1.6 var(--font-mono); }
  .source-index strong { display: inline-block; margin-top: var(--space-3); padding: 3px 6px; border: 1px solid var(--alert-red); color: var(--alert-red); font-size: 0.62rem; text-transform: uppercase; }
  .source-header > div:last-child { grid-column: 4 / 12; }
  .source-header h1 { max-width: 13ch; }
  .tracks { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: var(--space-5) 0; }
  .official-link { font: 650 0.72rem var(--font-mono); border-bottom: 1px solid var(--border-strong); padding-bottom: 3px; }
  .stage-health { display: grid; grid-template-columns: repeat(4, 1fr) 2fr; gap: var(--space-4); padding: var(--space-5); border: 1px solid var(--border-strong); background: var(--bg-elev); }
  .stage-health div { display: grid; gap: var(--space-2); }
  .stage-health div strong { font: 650 0.72rem var(--font-mono); text-transform: uppercase; }
  .stage-health p { margin: 0; color: var(--ink-muted); font-size: 0.75rem; overflow-wrap: anywhere; }
  section { padding-top: var(--space-9); }
  .section-heading { margin-bottom: var(--space-5); }
  .section-heading p { margin-bottom: var(--space-2); }
  .empty, .ledger-copy { color: var(--ink-muted); max-width: 68ch; }
  .snapshot-list { list-style: none; margin: var(--space-5) 0; padding: 0; border-top: 1px solid var(--border); }
  .snapshot-list li { display: flex; justify-content: space-between; gap: var(--space-4); padding: var(--space-2) 0; border-bottom: 1px solid var(--border); }
  .snapshot-list code, .snapshot-list time { font: 0.68rem var(--font-mono); color: var(--ink-muted); }
  .archive-link { font: 650 0.7rem var(--font-mono); }
  @media (max-width: 800px) { .source-header { display: block; } .source-index { margin-bottom: var(--space-5); } .stage-health { grid-template-columns: 1fr 1fr; } .stage-health p { grid-column: 1 / -1; } }
</style>
