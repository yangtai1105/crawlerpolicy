---
import Base from "../layouts/Base.astro";
import HealthStrip from "../components/HealthStrip.astro";
import FrontCard from "../components/FrontCard.astro";
import TrendTable from "../components/TrendTable.astro";
import DevelopmentCard from "../components/DevelopmentCard.astro";
import EvidenceRail from "../components/EvidenceRail.astro";
import { loadHealth } from "../lib/health";
import { loadLatestIntelligence } from "../lib/intelligence";
import { loadTrends } from "../lib/trends";
import { FRONTS, frontForTrack, type Front } from "../lib/taxonomy";
import { findSource } from "../lib/sources";
import { loadCurrentEvents } from "../lib/events";

const health = loadHealth();
const issue = loadLatestIntelligence();
const trends = loadTrends();
const events = (await loadCurrentEvents())
  .filter((event) => event.data.change_kind === "material")
  .sort((a, b) => b.data.event_date.getTime() - a.data.event_date.getTime());
const byId = new Map(events.map((event) => [event.data.slug, event]));
const activeFronts = new Set(events.map((event) => frontForTrack(event.data.primary_track)));

const frontCopy: Record<Front, string> = {
  "access-discovery": "Who can discover, crawl, index, and answer from the open web — and under which controls.",
  "agents-identity": "How autonomous agents identify themselves, request authority, and cross system boundaries.",
  "rights-markets": "Where licensing standards, creator controls, and market mechanisms are converging or splitting.",
  "governance-law": "The policy, regulatory, and litigation decisions reshaping machine access and downstream use.",
  "measurement-economics": "What traffic, referral, conversion, and compensation evidence reveals about the emerging economy.",
};

const evidenceItems = issue?.executive_shifts.flatMap((shift) =>
  shift.evidence_event_ids.flatMap((id) => {
    const event = byId.get(id);
    return event ? [{
      id,
      date: event.data.event_date.toISOString().slice(0, 10),
      title: event.data.title,
      source: findSource(event.data.source)?.display_name ?? event.data.source,
      url: `/events/${event.data.slug}`,
    }] : [];
  }),
) ?? [];

function summary(body: string | undefined): string {
  const match = body?.match(/## Why it matters\s*\n+([^#]+)/);
  return match?.[1].trim().slice(0, 260) ?? "";
}
---

<Base title="Web intelligence">
  <div class="container home">
    <header class="hero observation-grid">
      <div class="hero-index">
        <p class="utility-label">Current intelligence</p>
        <p>{issue ? `${issue.week} · completed window` : "First verified cycle pending"}</p>
      </div>
      <div class="hero-thesis">
        <h1>{issue ? issue.thesis : "New intelligence cycle starting."}</h1>
        <p>
          {issue
            ? issue.intelligence_read
            : "Crawler Policy now separates collected evidence, verified developments, durable trends, and weekly conclusions. Current intelligence begins with post-refactor evidence only."}
        </p>
        <div class="hero-actions">
          <a href="/intelligence">Open weekly intelligence →</a>
          {!issue && <a href="/archive">Browse historical records</a>}
        </div>
      </div>
    </header>

    <HealthStrip health={health} />

    <section class="section shifts">
      <div class="section-heading">
        <p class="utility-label">Executive shifts</p>
        <h2>{issue ? "What moved this week" : "No verified weekly shift yet"}</h2>
      </div>
      {issue && issue.executive_shifts.length ? (
        <div class="shift-grid">
          {issue.executive_shifts.map((shift) => (
            <article><h3>{shift.headline}</h3><p>{shift.summary}</p></article>
          ))}
        </div>
      ) : (
        <p class="empty-read">The first completed run will place only evidence-backed, material changes here. Legacy records stay separate.</p>
      )}
      {evidenceItems.length > 0 && <EvidenceRail thesis="Primary records supporting this week’s executive read." items={evidenceItems} />}
    </section>

    <section class="section" id="fronts">
      <div class="section-heading compact-heading">
        <div><p class="utility-label">Five public fronts</p><h2>The control plane</h2></div>
        <p>Nine internal tracks roll up into five stable questions readers can follow.</p>
      </div>
      <div class="front-grid">
        {FRONTS.map((front) => <FrontCard front={front} summary={frontCopy[front]} status={activeFronts.has(front) ? "active" : "quiet"} />)}
      </div>
    </section>

    <section class="section">
      <div class="section-heading compact-heading">
        <div><p class="utility-label">Durable signals</p><h2>Trend state</h2></div>
        <p>Status changes require primary or measurement evidence.</p>
      </div>
      <TrendTable trends={trends} />
    </section>

    <section class="section">
      <div class="section-heading compact-heading">
        <div><p class="utility-label">Current record</p><h2>Latest verified developments</h2></div>
        <a href="/developments">All developments →</a>
      </div>
      {events.length ? events.slice(0, 6).map((event) => (
        <DevelopmentCard slug={event.data.slug} title={event.data.title} source={findSource(event.data.source)?.display_name ?? event.data.source} eventDate={event.data.event_date} tracks={[...event.data.tracks]} tier={event.data.source_tier} confidence={event.data.confidence} summary={summary(event.body)} />
      )) : <p class="empty-read">No schema-v2 material developments yet. The pipeline is establishing its first verified baseline.</p>}
    </section>

    <section class="section watchlist">
      <div><p class="utility-label">Next evidence</p><h2>Watchlist</h2></div>
      <ol>
        {(issue?.watchlist.length ? issue.watchlist : [
          { question: "Which primary source will produce the first post-refactor material development?", tracks: [] },
          { question: "Will identity and rights signals become deployable controls rather than policy statements?", tracks: [] },
        ]).map((item) => <li>{item.question}</li>)}
      </ol>
    </section>
  </div>
</Base>

<style>
  .home { padding-top: var(--space-8); }
  .hero { padding: var(--space-5) 0 var(--space-8); }
  .hero-index { grid-column: 1 / 4; color: var(--ink-muted); font-size: 0.78rem; }
  .hero-index p:last-child { margin-top: var(--space-3); font-family: var(--font-mono); }
  .hero-thesis { grid-column: 4 / 12; }
  .hero-thesis h1 { max-width: 11ch; }
  .hero-thesis > p { max-width: 66ch; margin: var(--space-5) 0; color: var(--ink-muted); font-size: 1.02rem; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: var(--space-5); font: 650 0.72rem var(--font-mono); }
  .hero-actions a { border-bottom: 1px solid var(--border-strong); padding-bottom: var(--space-1); }
  .section { padding-top: var(--space-9); }
  .section-heading { margin-bottom: var(--space-6); }
  .section-heading .utility-label { margin-bottom: var(--space-2); }
  .compact-heading { display: flex; justify-content: space-between; gap: var(--space-6); align-items: end; }
  .compact-heading > p { max-width: 44ch; margin: 0; color: var(--ink-muted); font-size: 0.82rem; }
  .compact-heading > a { font: 650 0.72rem var(--font-mono); white-space: nowrap; }
  .shift-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--border-strong); }
  .shift-grid article { padding: var(--space-5); border-right: 1px solid var(--border); background: color-mix(in srgb, var(--bg-elev) 72%, transparent); }
  .shift-grid article:last-child { border-right: 0; }
  .shift-grid h3 { margin-bottom: var(--space-3); }
  .shift-grid p, .empty-read { color: var(--ink-muted); font-size: 0.86rem; max-width: 68ch; }
  .shifts :global(.evidence-rail) { margin-top: var(--space-7); max-width: 880px; }
  .front-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: var(--space-4); }
  .front-grid > :global(article) { grid-column: span 2; }
  .front-grid > :global(article:nth-child(4)), .front-grid > :global(article:nth-child(5)) { grid-column: span 3; }
  .watchlist { display: grid; grid-template-columns: 1fr 2fr; gap: var(--space-7); padding-bottom: var(--space-6); border-top: 1px solid var(--border-strong); padding-top: var(--space-7); }
  .watchlist ol { margin: 0; padding-left: 1.4rem; }
  .watchlist li { padding: 0 0 var(--space-4) var(--space-2); border-bottom: 1px solid var(--border); margin-bottom: var(--space-4); }
  @media (max-width: 800px) {
    .hero { display: block; }
    .hero-index { margin-bottom: var(--space-6); }
    .compact-heading, .watchlist { display: block; }
    .compact-heading > p, .compact-heading > a { display: block; margin-top: var(--space-3); }
    .shift-grid, .front-grid { grid-template-columns: 1fr; }
    .front-grid > :global(article), .front-grid > :global(article:nth-child(4)), .front-grid > :global(article:nth-child(5)) { grid-column: auto; }
    .watchlist ol { margin-top: var(--space-5); }
  }
</style>
