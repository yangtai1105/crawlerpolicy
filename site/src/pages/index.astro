---
import Base from "../layouts/Base.astro";
import HealthStrip from "../components/HealthStrip.astro";
import FrontCard from "../components/FrontCard.astro";
import FeedCard from "../components/FeedCard.astro";
import TrackTag from "../components/TrackTag.astro";
import { loadHealth } from "../lib/health";
import { loadLatestIntelligence } from "../lib/intelligence";
import { FRONTS, frontForTrack, type Front } from "../lib/taxonomy";
import { findSource } from "../lib/sources";
import { loadCurrentEvents } from "../lib/events";
import { feedSection, loadFeedItems } from "../lib/feed";

const health = loadHealth();
const issue = loadLatestIntelligence();
const events = (await loadCurrentEvents()).filter((event) => event.data.change_kind === "material");
const feedItems = await loadFeedItems();
const newestPublishedAt = feedItems[0]?.data.published_at.getTime();
const newestWindow = newestPublishedAt === undefined
  ? []
  : feedItems.filter((item) => item.data.published_at.getTime() >= newestPublishedAt - 48 * 60 * 60 * 1000);
const verifiedByImportance = newestWindow
  .filter((item) => item.data.status === "verified")
  .sort((a, b) => b.data.importance - a.data.importance || b.data.published_at.getTime() - a.data.published_at.getTime());
const lead = verifiedByImportance[0] ?? feedItems[0];
const latest = feedItems.filter((item) => item.data.slug !== lead?.data.slug).slice(0, 8);
const activeFronts = new Set([
  ...events.map((event) => frontForTrack(event.data.primary_track)),
  ...feedItems.slice(0, 12).map((item) => frontForTrack(item.data.primary_track)),
]);
const publicationDate = (lead?.data.published_at ?? new Date()).toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
const statusLabel = lead ? lead.data.status[0].toUpperCase() + lead.data.status.slice(1) : "Awaiting first signal";

const frontCopy: Record<Front, string> = {
  "access-discovery": "Who can discover, crawl, index, and answer from the open web — and under which controls.",
  "agents-identity": "How autonomous agents identify themselves, request authority, and cross system boundaries.",
  "rights-markets": "Where licensing standards, creator controls, and market mechanisms are converging or splitting.",
  "governance-law": "The policy, regulatory, and litigation decisions reshaping machine access and downstream use.",
  "measurement-economics": "What traffic, referral, conversion, and compensation evidence reveals about the emerging economy.",
};
---

<Base title="The AI × web ecosystem" description="Readable intelligence on AI crawlers, agent identity, content rights, and the economics of the open web.">
  <div class="container home">
    <header class="hero">
      <div class="hero-meta">
        <p class="utility-label">Field Ledger · Today in the ecosystem</p>
        <time datetime={(lead?.data.published_at ?? new Date()).toISOString()}>{publicationDate}</time>
      </div>
      <h1>The web is negotiating with its new readers.</h1>
      <p class="hero-deck">A daily intelligence feed about AI access, agent identity, content rights, policy, and the emerging machine-traffic economy.</p>
    </header>

    {lead ? (
      <article class="lead-signal" data-status={lead.data.status}>
        <div class="lead-meta">
          <span class="lead-status">{statusLabel}</span>
          <span>{findSource(lead.data.source)?.display_name ?? lead.data.source}</span>
          <span>{lead.data.backfilled ? "Backfilled · Original publication" : "Lead signal"}</span>
        </div>
        <h2><a href={`/events/${lead.data.slug}`}>{lead.data.title}</a></h2>
        <div class="lead-reading">
          <div><p class="utility-label">Summary</p><p>{feedSection(lead.body, "Summary")}</p></div>
          <div class="lead-why"><p class="utility-label">Why it matters</p><p>{feedSection(lead.body, "Why it matters")}</p></div>
        </div>
        <footer>
          <div>{lead.data.tracks.map((track) => <TrackTag track={track} linked />)}</div>
          <a href={`/events/${lead.data.slug}`}>Read the full analysis →</a>
        </footer>
      </article>
    ) : (
      <section class="lead-empty">
        <p class="utility-label">Publication opening</p>
        <h2>No new verified developments today.</h2>
        <p>The new feed begins with evidence published on or after August 30, 2026. Sources are being checked; historical items will not be republished as current news.</p>
      </section>
    )}

    {health.status !== "healthy" && <HealthStrip health={health} compact />}

    <section class="section latest-section">
      <div class="section-heading">
        <div><p class="utility-label">Daily ecosystem feed</p><h2>Latest signals</h2></div>
        <p>Summary first. Analysis next. Evidence always available.</p>
      </div>
      <div class="feed-list">
        {latest.length ? latest.map((item) => (
          <FeedCard
            slug={item.data.slug}
            title={item.data.title}
            source={findSource(item.data.source)?.display_name ?? item.data.source}
            publishedAt={item.data.published_at}
            status={item.data.status}
            summary={feedSection(item.body, "Summary")}
            analyticalLabel={item.data.importance >= 0.7 ? "Why it matters" : "Insight"}
            analyticalText={feedSection(item.body, item.data.importance >= 0.7 ? "Why it matters" : "Insight")}
            tracks={[...item.data.tracks]}
            backfilled={item.data.backfilled}
          />
        )) : (
          <p class="empty-read">{lead ? "No additional signals in this publication window." : "The first post-launch ecosystem items will appear here."}</p>
        )}
      </div>
    </section>

    <section class="section themes-section">
      <div class="section-heading">
        <div><p class="utility-label">Follow the structure</p><h2>Active themes</h2></div>
        <a href="/fronts">Explore all themes →</a>
      </div>
      <div class="front-grid">
        {FRONTS.map((front) => <FrontCard front={front} summary={frontCopy[front]} status={activeFronts.has(front) ? "active" : "quiet"} />)}
      </div>
    </section>

    <section class="weekly-entry">
      <div>
        <p class="utility-label">Weekly intelligence</p>
        <h2>{issue?.thesis ?? "The durable read begins after a complete evidence window."}</h2>
      </div>
      <div>
        <p>{issue?.intelligence_read ?? "Daily signals become weekly intelligence only when verified evidence supports a durable shift. Reported stories and early signals remain visible without moving the conclusion."}</p>
        <a href="/intelligence">Open the weekly read →</a>
      </div>
    </section>
  </div>
</Base>

<style>
  .home { padding-top: var(--space-7); }
  .hero { position: relative; padding: var(--space-4) 0 var(--space-6); border-bottom: 1px solid var(--quiet-rule); }
  .hero::before { position: absolute; top: 1.1rem; right: 0; width: min(34vw, 390px); height: 4px; background: var(--clay-marker); content: ""; }
  .hero-meta { display: flex; justify-content: space-between; gap: var(--space-5); color: var(--ink-muted); font: 500 .67rem var(--font-mono); }
  .hero h1 { max-width: 18ch; margin-top: var(--space-5); font-size: clamp(2.6rem, 4.8vw, 4.8rem); }
  .hero-deck { max-width: 720px; margin: var(--space-4) 0 0; color: var(--ink-muted); font-size: clamp(1rem, 1.5vw, 1.15rem); }
  .lead-signal { position: relative; margin-top: var(--space-6); padding: clamp(28px, 3.5vw, 48px); border: 1px solid var(--forest-block); border-radius: var(--radius-md); background: var(--forest-block); color: var(--paper-high); box-shadow: 10px 10px 0 var(--clay-marker); }
  .lead-meta { display: flex; flex-wrap: wrap; gap: var(--space-3); color: #c3d2c8; font: 600 .63rem var(--font-mono); text-transform: uppercase; }
  .lead-meta span + span::before { margin-right: var(--space-3); color: var(--evidence-mint); content: "·"; }
  .lead-status { color: #b6dcc7; }
  .lead-signal[data-status="reported"] .lead-status { color: #efb7a7; }
  .lead-signal[data-status="signal"] .lead-status { color: #e7c28d; }
  .lead-signal h2 { max-width: 27ch; margin: var(--space-4) 0 var(--space-5); font-size: clamp(2rem, 3.5vw, 3.8rem); }
  .lead-reading { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 6vw, 80px); max-width: 1000px; }
  .lead-reading > div > p:last-child { max-width: 62ch; color: #e4ece7; font-size: 1rem; }
  .lead-reading .utility-label { color: var(--evidence-mint); }
  .lead-why { padding-left: var(--space-5); border-left: 3px solid var(--clay-marker); }
  .lead-why .utility-label { color: #efaa97; }
  .lead-signal footer { display: flex; justify-content: space-between; gap: var(--space-5); align-items: end; margin-top: var(--space-7); padding-top: var(--space-4); border-top: 1px solid #486052; }
  .lead-signal footer > div { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .lead-signal footer > a { color: #b6dcc7; font: 600 .68rem var(--font-mono); white-space: nowrap; }
  .lead-empty { padding: clamp(32px, 6vw, 72px); border: 1px solid var(--quiet-rule); border-radius: var(--radius-md); background: var(--paper-high); }
  .lead-empty h2 { max-width: 18ch; margin: var(--space-4) 0; }
  .lead-empty > p:last-child { max-width: 68ch; color: var(--ink-muted); }
  :global(.health-strip) { margin-top: var(--space-4); }
  .section { padding-top: var(--space-9); }
  .section-heading { display: flex; justify-content: space-between; gap: var(--space-6); align-items: end; margin-bottom: var(--space-6); }
  .section-heading .utility-label { margin-bottom: var(--space-2); }
  .section-heading > p { max-width: 43ch; margin: 0; color: var(--ink-muted); font-size: .82rem; }
  .section-heading > a { color: var(--forest-block); font: 600 .68rem var(--font-mono); white-space: nowrap; }
  .feed-list { border-bottom: 1px solid var(--border-strong); }
  .empty-read { max-width: 68ch; padding: var(--space-5) 0; border-top: 1px solid var(--quiet-rule); color: var(--ink-muted); }
  .front-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: var(--space-4); }
  .front-grid > :global(article) { grid-column: span 2; }
  .front-grid > :global(article:nth-child(4)), .front-grid > :global(article:nth-child(5)) { grid-column: span 3; }
  .weekly-entry { display: grid; grid-template-columns: 1.25fr .75fr; gap: var(--space-8); margin-top: var(--space-9); padding: var(--space-8) var(--space-6); border-top: 1px solid var(--quiet-rule); border-bottom: 1px solid var(--quiet-rule); background: var(--paper-high); }
  .weekly-entry h2 { max-width: 17ch; margin-top: var(--space-3); }
  .weekly-entry > div:last-child { align-self: end; }
  .weekly-entry > div:last-child p { color: var(--ink-muted); font-size: .88rem; }
  .weekly-entry a { color: var(--clay-marker); font: 600 .68rem var(--font-mono); }
  @media (max-width: 800px) {
    .lead-reading, .weekly-entry { grid-template-columns: 1fr; gap: var(--space-5); }
    .lead-signal footer, .section-heading { align-items: start; flex-direction: column; }
    .front-grid { grid-template-columns: 1fr; }
    .front-grid > :global(article), .front-grid > :global(article:nth-child(4)), .front-grid > :global(article:nth-child(5)) { grid-column: auto; }
  }
  @media (max-width: 480px) {
    .home { padding-top: var(--space-5); }
    .hero::before { display: none; }
    .hero-meta { align-items: start; flex-direction: column; gap: var(--space-2); }
    .lead-signal { padding: var(--space-5); }
    .lead-signal h2 { margin-bottom: var(--space-6); }
    .lead-signal footer > a { white-space: normal; }
  }
</style>
