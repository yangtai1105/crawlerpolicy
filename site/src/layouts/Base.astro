---
import "@fontsource-variable/inter/index.css";
import "@fontsource-variable/archivo/index.css";
import "../styles/global.css";
import { loadHealth } from "../lib/health";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Evidence-backed intelligence on machine access, content rights, agent identity, and the emerging web economy." } = Astro.props;

const health = loadHealth();
const lastSuccess = health.last_fully_successful_at
  ? new Date(health.last_fully_successful_at).toUTCString().replace("GMT", "UTC")
  : "No verified full run yet";
const coverage = health.coverage.configured
  ? `${health.coverage.completed}/${health.coverage.configured} sources completed`
  : "Coverage awaiting first schema-v2 run";
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Crawler Policy</title>
    <meta name="description" content={description} />
    <link rel="alternate" type="application/rss+xml" title="Crawler Policy developments" href="/feed.xml" />
  </head>
  <body>
    <nav class="site-nav">
      <div class="container site-nav-inner">
        <a href="/" class="brand-lockup" aria-label="Crawler Policy home">
          <span class="brand">Crawler Policy</span>
          <span class="brand-descriptor">Rights, Access &amp; Agentic Web Intelligence</span>
        </a>
        <div class="links">
          <a href="/intelligence">Intelligence</a>
          <a href="/developments">Developments</a>
          <a href="/#fronts">Fronts</a>
          <a href="/sources">Sources</a>
          <a href="/archive">Legacy Archive</a>
          <a href="/about">About</a>
        </div>
        <button
          class="theme-toggle"
          type="button"
          aria-label="Switch color theme"
          title="Switch color theme"
          onclick="
            const el = document.documentElement;
            const next = el.dataset.theme === 'dark' ? 'light' : 'dark';
            el.dataset.theme = next;
            localStorage.setItem('theme', next);
          "
        >◐</button>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <p class="footer-status">
          <span class="utility-label">Last fully successful run</span><br />
          <strong>{lastSuccess}</strong>
        </p>
        <p>
          Pipeline status: <strong>{health.status}</strong> · {coverage}. Analysis is model-assisted;
          linked evidence remains the record of authority.
        </p>
        <div class="footer-links">
          <a href="/feed.xml">RSS</a>
          <a href="/about">Method</a>
          <a href="/archive">Archive</a>
        </div>
      </div>
    </footer>

    <script is:inline>
      // Apply saved theme before hydration to avoid flash.
      (function () {
        const saved = localStorage.getItem("theme");
        if (saved === "light" || saved === "dark") {
          document.documentElement.dataset.theme = saved;
        }
      })();
    </script>
  </body>
</html>
