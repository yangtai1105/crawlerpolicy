---
import "@fontsource-variable/ibm-plex-sans/index.css";
import "@fontsource/ibm-plex-sans-condensed/600.css";
import "@fontsource/ibm-plex-sans-condensed/700.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-mono/600.css";
import "../styles/global.css";
import { loadHealth } from "../lib/health";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Evidence-backed intelligence on machine access, content rights, agent identity, and the emerging web economy." } = Astro.props;

const health = loadHealth();
const lastSuccess = health.last_fully_successful_at
  ? new Date(health.last_fully_successful_at).toUTCString().replace("GMT", "UTC")
  : "No verified full run yet";
const coverage = health.coverage.configured
  ? `${health.coverage.completed}/${health.coverage.configured} sources completed`
  : "Coverage awaiting first schema-v2 run";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Crawler Policy</title>
    <meta name="description" content={description} />
    <link rel="alternate" type="application/rss+xml" title="Crawler Policy developments" href="/feed.xml" />
  </head>
  <body>
    <nav class="site-nav">
      <div class="container site-nav-inner">
        <a href="/" class="brand-lockup" aria-label="Crawler Policy home">
          <span class="brand">Crawler Policy</span>
          <span class="brand-descriptor">Field Ledger · Rights, Access &amp; Agentic Web</span>
        </a>
        <div class="links">
          <a href="/">Feed</a>
          <a href="/intelligence">Weekly</a>
          <a href="/fronts">Themes</a>
          <a href="/sources">Sources</a>
          <a href="/about">About</a>
        </div>
        <a class="nav-rss" href="/feed.xml">RSS ↗</a>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <p class="footer-status">
          <span class="utility-label">Last fully successful run</span><br />
          <strong>{lastSuccess}</strong>
        </p>
        <p>
          <strong>{health.status === "healthy" ? "Updates current" : "Updates delayed"}</strong> · {coverage}.
          Gemini assists the analysis; linked evidence remains authoritative.
        </p>
        <div class="footer-links">
          <a href="/feed.xml">RSS</a>
          <a href="/developments">Verified developments</a>
          <a href="/archive">Legacy archive</a>
        </div>
      </div>
    </footer>
  </body>
</html>
